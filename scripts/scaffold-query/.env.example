# Anthropic API key for the query agent. Resolution order (CASE-509):
#   1. a key set at runtime via the admin /settings page (in-memory + the file below)
#   2. ANTHROPIC_API_KEY_FILE (a 0600 key file — survives restart)
#   3. ANTHROPIC_API_KEY (this literal — frozen at process start, needs a redeploy to change)
# For local dev the literal below is enough.
ANTHROPIC_API_KEY=sk-ant-...
# Persistent key file so /settings can set/rotate the key WITHOUT a redeploy and
# have it survive a restart. MUST point at a writable, persistent path (a mounted
# volume in k8s) — otherwise a UI-set key reverts to the literal above on restart.
# Declare this in apps/<name>/wip-app.yaml on a persistent mount. Unset = the UI
# can still set a key, but only in-memory (lost on restart).
# ANTHROPIC_API_KEY_FILE=/data/secrets/anthropic-key

# WIP connection (stdio mode — local development)
MCP_PYTHON=/path/to/WorldInPie/.venv/bin/python
MCP_CWD=/path/to/WorldInPie
# Runtime key SOURCE: the live wip-deploy secrets file (CASE-495). Resolved at
# startup (the same file the MCP server uses), so a key rotation / target-
# redeploy is picked up on restart instead of stranding a baked, stale value.
# create-app-project.sh fills this with the real path.
WIP_API_KEY_FILE=/path/to/.wip-deploy/wip-dev-local/secrets/api-key
# Local override: a literal key still works when WIP_API_KEY_FILE is unset.
# WIP_API_KEY=dev_master_key_for_testing

# WIP connection (remote mode — K8s/server)
# MCP_URL=http://wip-mcp-server:8007/mcp
# MCP_TRANSPORT=http

# Path prefix for k8s / ingress deployment (CASE-370). Leave BOTH unset for
# local dev — the app serves at '/'. wip-deploy sets these when installing the
# app under a prefix (e.g. /apps/myapp):
#   APP_BASE_PATH  — server-side: Express router mount + session cookie path +
#                    prod static SPA mount (and the OIDC redirect URL base).
#   VITE_BASE_PATH — build-time: Vite `base`, so import.meta.env.BASE_URL and
#                    every client fetch/link is prefix-aware. Usually equals
#                    APP_BASE_PATH.
# APP_BASE_PATH=/apps/myapp
# VITE_BASE_PATH=/apps/myapp

# Build stamp (CASE-472) — build-time only, set by the image builder via the
# Dockerfile's --build-arg, NOT runtime env. A running app shows these in a
# small footer so you can tell which build you're looking at. Leave unset for
# local builds (the UI hides the stamp). The image-build pipeline supplies:
#   VITE_BUILD_STAMP — e.g. $(date -u +%FT%TZ)
#   VITE_BUILD_SHA   — e.g. $(git rev-parse --short HEAD)
# Build with: docker build --build-arg VITE_BUILD_STAMP=... --build-arg VITE_BUILD_SHA=... .

# OIDC authentication (optional — enables user login via Dex)
# Set OIDC_ISSUER to enable auth. Users are redirected to Dex login.
# OIDC_ISSUER=http://localhost:5556/dex
# OIDC_CLIENT_ID=wip-apps
# OIDC_CLIENT_SECRET=wip-apps-secret
# SESSION_SECRET=change-me-to-a-random-string

# App-level access control (optional — restricts which Dex groups can use this app)
# Comma-separated group names. Empty or unset = all authenticated users allowed.
# ALLOWED_GROUPS=wip-admins,clintrial-users

# Admin groups for privileged config endpoints (the /settings Anthropic-key page,
# CASE-509). Comma-separated; defaults to wip-admins when unset. In dev mode (no
# OIDC_ISSUER) the admin endpoints are open, mirroring the rest of dev auth.
# ADMIN_GROUPS=wip-admins

# Optional: restrict queries to a specific namespace
# WIP_NAMESPACE=myapp

# Optional: Claude model (default: claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-sonnet-4-5-20241022

# Optional: session TTL in minutes (default: 30)
# SESSION_TTL_MINUTES=30

# Optional: max tool-call turns per question (default: 15)
# MAX_TURNS=15
