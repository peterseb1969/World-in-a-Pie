# Python
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Environment
.env.local
.env.*.local

# IDE
.idea/
.vscode/
.github/copilot-instructions.md
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
*.log

# npm pack artifacts. Exception (force-added with `git add -f`): the CURRENT
# wip-<lib>-<version>.tgz in each libs/wip-* dir — the versioned, immutable
# lib artifact apps consume (CASE-442). On a version bump: `git rm` the old
# tarball, `git add -f` the new one.
*.tgz

# Generated config files (created by scripts/setup.sh)
config/dex/config.yaml
config/caddy/Caddyfile
config/nats/nats.conf
config/console/nginx.conf
config/last-install.conf
.env

# User-specific config
my-setup.conf
*.local.conf

# Docker-compose override files (auto-generated by setup.sh for dev variant)
components/*/docker-compose.override.yml
ui/*/docker-compose.override.yml

# Secrets (production mode)
data/secrets/

# Testing
.pytest_cache/
.coverage
htmlcov/
testdata/
results.json

# Setup logs
logs/

# Quality audit raw output
reports/quality-audit/raw/

# Session report staging (CASE-467/463): tier-3 sessions stage to project-local
# reports/<session-id>/. World-in-a-Pie is PUBLIC — those session narratives
# must NOT be committed (the kb mirror is the durable record). Ignore every
# subdir of reports/ EXCEPT the tracked audit artifacts; SECURITY-AUDIT.md is a
# file (not matched by the dir glob) so it stays tracked.
reports/*/
!reports/quality-audit/

# K8s deployment secrets (real credentials, never commit)
k8s/secrets.local.yaml

# Generated by setup scripts (agent-role-specific). Contents-glob (not bare
# `.claude/`) so the committed permission baseline can be un-ignored —
# negation can't reach inside an ignored directory (CASE-446).
CLAUDE.md
.claude/*
!.claude/settings.json
# .claude/kb.json (CASE-463 tier-3 flag) stays ignored DELIBERATELY: this is
# a public repo — a committed kb.json would bake one operator's KB into every
# clone. Backend tier is per-clone; app repos commit theirs (private).
.claude-context-pct

# Local-only docs (deployment-specific, not committed)
docs/local/

# MCP config (contains API keys)
.mcp.json

# Local dev helper scripts with embedded credentials
start-wip-mcp.sh

# MongoDB data (local dev)
data/

# Cross-agent case discussions (symlink to shared store)
yac-discussions

# Local test fixtures (downloaded ontologies + generated terminology CSVs)
test-data/
